[Unit]
Description=HomePanel server %i
Documentation=https://github.com/C7PEK/cypek.dev-panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=homepanel
Group=homepanel
ExecStart=/usr/local/bin/homepanel shim %i
WorkingDirectory=/var/lib/homepanel/servers/%i
RuntimeDirectory=homepanel-%i
KillMode=mixed
TimeoutStopSec=180
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
LimitNOFILE=65536

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homepanel/servers/%i
ReadOnlyPaths=/var/lib/homepanel/runtimes

[Install]
WantedBy=multi-user.target

[Unit]
Description=panel.cypek.dev web panel
Documentation=https://github.com/C7PEK/cypek.dev-panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homepanel
Group=homepanel
ExecStart=/usr/local/bin/homepanel serve --config /etc/homepanel/config.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/homepanel /var/log/homepanel
ReadOnlyPaths=/etc/homepanel

[Install]
WantedBy=multi-user.target

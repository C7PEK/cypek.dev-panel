[Unit]
Description=panel.cypek.dev database add-on installer (MariaDB + phpMyAdmin)
After=network-online.target
Wants=network-online.target

[Service]
# Started by the panel (polkit allows exactly this unit); runs as root
# because it installs packages. Re-running is safe.
Type=oneshot
ExecStart=/usr/local/bin/homepanel install-database
TimeoutStartSec=30min
